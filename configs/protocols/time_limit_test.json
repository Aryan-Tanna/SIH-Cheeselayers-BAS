{
    "protocol_id": "time_limit_test",
    "version": "1.0",
    "title": "Synthetic: per-step time limit",
    "description": "Test-only protocol, not a real experiment. bas_specimen_v1's steps on the lidless synthetic profile, with a 20 s time limit on remove_b. Exercises step_time_limit's exclusion hold: remove_b is due as soon as the container opens, but its clock must not run while module A is out (one_module_at_a_time), or a correct free-order run would alarm.",
    "inherits": "configs/defaults.yaml",
    "object_profile": "configs/objects/profile_repeatable_test.yaml",
    "roles": {
        "container": {
            "required": true
        },
        "module_a": {
            "required": true
        },
        "module_b": {
            "required": true
        }
    },
    "zones": {
        "stow_zone": {
            "frame": "rack"
        },
        "container_interior": {
            "frame": "rack"
        }
    },
    "steps": [
        {
            "id": "open_container",
            "action": "open",
            "target": "container",
            "prompt": "Open the payload container.",
            "success": "Container open. Select a specimen module."
        },
        {
            "id": "handle_a",
            "type": "group",
            "after": [
                "open_container"
            ],
            "steps": [
                {
                    "id": "remove_a",
                    "action": "remove_from",
                    "target": "module_a",
                    "source": "container",
                    "prompt": "Remove the first specimen module."
                },
                {
                    "id": "open_a_lid",
                    "action": "open",
                    "target": "module_a",
                    "condition": "target.has_lid",
                    "after": [
                        "remove_a"
                    ],
                    "prompt": "Unseal the module."
                },
                {
                    "id": "stow_a_lid",
                    "action": "move_to_zone",
                    "target": "module_a.lid",
                    "zone": "stow_zone",
                    "condition": "target.has_lid",
                    "after": [
                        "open_a_lid"
                    ],
                    "prompt": "Secure the lid in the stow zone."
                },
                {
                    "id": "close_a_lid",
                    "action": "close",
                    "target": "module_a",
                    "condition": "target.has_lid",
                    "after": [
                        "stow_a_lid"
                    ],
                    "prompt": "Reseal the module."
                },
                {
                    "id": "return_a",
                    "action": "place_into",
                    "target": "module_a",
                    "dest": "container",
                    "after": [
                        "close_a_lid"
                    ],
                    "prompt": "Return the module to the container.",
                    "success": "First module secured."
                }
            ]
        },
        {
            "id": "handle_b",
            "type": "group",
            "after": [
                "open_container"
            ],
            "steps": [
                {
                    "id": "remove_b",
                    "action": "remove_from",
                    "target": "module_b",
                    "source": "container",
                    "prompt": "Remove the second specimen module.",
                    "timeout_s": 20
                },
                {
                    "id": "open_b_lid",
                    "action": "open",
                    "target": "module_b",
                    "condition": "target.has_lid",
                    "after": [
                        "remove_b"
                    ],
                    "prompt": "Unseal the module."
                },
                {
                    "id": "stow_b_lid",
                    "action": "move_to_zone",
                    "target": "module_b.lid",
                    "zone": "stow_zone",
                    "condition": "target.has_lid",
                    "after": [
                        "open_b_lid"
                    ],
                    "prompt": "Secure the lid in the stow zone."
                },
                {
                    "id": "close_b_lid",
                    "action": "close",
                    "target": "module_b",
                    "condition": "target.has_lid",
                    "after": [
                        "stow_b_lid"
                    ],
                    "prompt": "Reseal the module."
                },
                {
                    "id": "return_b",
                    "action": "place_into",
                    "target": "module_b",
                    "dest": "container",
                    "after": [
                        "close_b_lid"
                    ],
                    "prompt": "Return the module to the container."
                }
            ]
        },
        {
            "id": "close_container",
            "action": "close",
            "target": "container",
            "after": [
                "handle_a",
                "handle_b"
            ],
            "prompt": "Seal the payload container.",
            "success": "Experiment complete. Log written."
        }
    ]
}
